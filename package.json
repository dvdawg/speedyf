{
  "name": "speedyf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SpeedyF — fast, memory-bounded desktop PDF viewer and editor",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "bash scripts/bench.sh",
    "bench:release": "bash scripts/bench.sh --release",
    "fixture:smoke": "node scripts/make-smoke-pdf.mjs",
    "tauri": "tauri",
    "fetch-pdfium": "node scripts/fetch-pdfium.mjs",
    "check": "pnpm check:web && pnpm check:rust",
    "check:web": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "check:rust": "pnpm check:rust:fmt && pnpm check:rust:clippy && pnpm check:rust:test",
    "check:rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "check:rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "check:rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "fmt:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tauri-apps/cli": "^2.11.4",
    "eslint": "^9.39.0",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^16.5.0",
    "happy-dom": "^20.11.6",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.4",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^4.0.17"
  }
}
