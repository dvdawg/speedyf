{
  "id": "dev.speedyf.references",
  "apiVersion": 1,
  "name": "References",
  "version": "2.0.0",
  "description": "Every work this paper cites, where it is cited, and which ones you already have.",
  "author": "speedyf",
  "entry": "worker.js",
  "icon": "icon.svg",
  "permissions": ["document:read", "citations:read", "commands:run", "storage"],
  "contributes": {
    "panels": [{ "id": "refs", "title": "References" }],
    "commands": [
      { "id": "refs", "title": "References: Show", "keywords": ["citations", "cited"] },
      { "id": "rescan", "title": "References: Rescan Document", "keywords": ["refresh"] },
      { "id": "jump", "title": "References: Go To Citation", "keywords": ["navigate"] }
    ],
    "settings": [
      {
        "key": "sort",
        "title": "Order",
        "type": "select",
        "default": "appearance",
        "options": ["appearance", "most cited", "title"],
        "description": "How to order the list."
      },
      {
        "key": "group",
        "title": "Separate what you already have",
        "type": "checkbox",
        "default": "true",
        "description": "Split into works in your library and works not in it."
      }
    ]
  }
}
