{
  "id": "dev.speedyf.references",
  "apiVersion": 1,
  "name": "References",
  "version": "4.0.0",
  "description": "Every work this paper cites: its title, its authors, the pages it is cited on, and whether you already have it.",
  "author": "speedyf",
  "entry": "worker.js",
  "icon": "icon.svg",
  "permissions": [
    "document:read",
    "citations:read",
    "commands:run",
    "storage",
    "library:contributeReferences"
  ],
  "contributes": {
    "panels": [
      {
        "id": "refs",
        "title": "References"
      }
    ],
    "commands": [
      {
        "id": "refs",
        "title": "References: Show",
        "keywords": ["citations", "cited"]
      },
      {
        "id": "rescan",
        "title": "References: Rescan Document",
        "keywords": ["refresh"]
      },
      {
        "id": "jump",
        "title": "References: Open Reference",
        "keywords": ["navigate", "cited", "where"]
      },
      {
        "id": "goto",
        "title": "References: Go To This Citation",
        "keywords": ["navigate", "jump"]
      },
      {
        "id": "provide",
        "title": "References: Read a Library Document's Reference List"
      }
    ],
    "referenceProvider": { "command": "provide" },
    "settings": [
      {
        "key": "sort",
        "title": "Order",
        "type": "select",
        "default": "appearance",
        "options": ["appearance", "most cited", "title"],
        "description": "How to order the list. \"Appearance\" is the order you meet them in while reading."
      },
      {
        "key": "group",
        "title": "Separate what you already have",
        "type": "checkbox",
        "default": "true",
        "description": "Split into works in your library and works not in it."
      }
    ]
  }
}
